# Kopiere diese Datei nach terminal.properties und passe sie an

# Zieladresse für die Scanzustellung über nginx mit mTLS
server.url=https://127.0.0.1:8444/api/scans

# Serieller Port des ESP32, unter Linux zum Beispiel /dev/ttyUSB0 oder /dev/ttyACM0.
# Ein nicht leerer Wert in TERMINAL_SERIAL_PORT hat Vorrang vor dieser Angabe.
# Bleiben beide Angaben leer, dient die Konsole zum Testen ohne Kartenleser
serial.port=

serial.baud=115200

# Privater Client-Schlüssel und Clientzertifikat dieser Installation als PKCS12-Datei.
# nginx prüft das Zertifikat gegen die Terminal-Client-CA. Ohne lesbaren KeyStore
# und Truststore kann der TLS-Kontext für die Zustellung nicht geladen werden
client.keystore=../.local/tls/terminal-23102003-client.p12
client.keystore.password=changeit

# PKCS12-Truststore mit der Server-CA. Die JVM prüft die Zertifikatskette
# gegen diesen Speicher und die Zieladresse gegen den Zertifikatsnamen
server.truststore=../.local/tls/terminal-server-truststore.p12
server.truststore.password=changeit

# Datei für noch nicht endgültig beantwortete Scans, einschließlich Kartenkennungen.
# Den Speicherort durch Betriebssystemrechte vor fremdem Zugriff schützen
queue.file=scan-puffer.jsonl
